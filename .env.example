# Copy to .env and fill in.

# Database
POSTGRES_PASSWORD=weather_dev_password
DATABASE_URL=postgresql://weather:weather_dev_password@localhost:5432/weather

# AI agent
ANTHROPIC_API_KEY=

# Weather data source
WEATHER_SOURCE=open-meteo
# NOAA_API_TOKEN=            # only needed if WEATHER_SOURCE=noaa

# Alerting (pick one for MVP)
SLACK_WEBHOOK_URL=

# API
# Leave unset for local dev (all endpoints open). Set to require clients to
# send a matching X-API-Key header (or ?api_key= on the /anomalies/live
# WebSocket) before exposing this service beyond localhost.
API_KEY=
# CHAT_MODEL=claude-opus-4-8
# LIVE_FEED_POLL_INTERVAL_SECONDS=3
